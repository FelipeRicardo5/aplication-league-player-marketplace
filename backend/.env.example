# Porta do servidor da API
PORT=3000

# Conexão com o PostgreSQL (mesmas credenciais do docker-compose.yml da raiz)
DATABASE_URL="postgresql://league:league@localhost:5432/league_marketplace"

# Origem do frontend liberada no CORS (pode ser uma lista separada por vírgula)
CORS_ORIGIN="http://localhost:5173"

# Nível dos logs (trace, debug, info, warn, error)
LOG_LEVEL=info
